{
  "manifest_version": 3,
  "name": "Wishlist+ for PriceCharting",
  "version": "1.4.7",
  "description": "Loads your whole PriceCharting wishlist at once and adds grid view, search, totals, Select/Exclude lists, and move-to-collection.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pricecharting.com/wishlist*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}